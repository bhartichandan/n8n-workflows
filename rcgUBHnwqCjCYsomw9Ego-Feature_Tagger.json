      "parameters": {
        "jsCode": "// Filter out items that already have tags\nconst items = $input.all();\nconst untaggedItems = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i].json;\n  \n  // Skip if already tagged (assuming column E contains tags)\n  if (!item.Tags || item.Tags === '' || item.Tags === null) {\n    untaggedItems.push({\n      json: {\n        ...item,\n        rowNumber: i + 1 // Store row number for update later\n      }\n    });\n  }\n}\n\nreturn untaggedItems;"
      },
